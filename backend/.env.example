# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opsflow?schema=public"

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:4000"

# Auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# Slack (Zero-Cost Attachment Ingestion — Section 5)
SLACK_BOT_TOKEN="xoxb-your-bot-token"
SLACK_SIGNING_SECRET="your-signing-secret"

# Slack OAuth ("Add to Slack" install + "Sign in with Slack")
# From your Slack app's Basic Information -> App Credentials page.
# Redirect URLs to register in Slack's OAuth & Permissions page:
#   {APP_URL}/api/v1/auth/slack/install/callback
#   {APP_URL}/api/v1/auth/slack/login/callback
SLACK_CLIENT_ID="your-client-id"
SLACK_CLIENT_SECRET="your-client-secret"

# OCR / Vision LLM (Multimodal parsing — Section 5.1)
# Gemini API key from https://aistudio.google.com/apikey (generativelanguage.googleapis.com).
LLM_API_KEY="your-llm-api-key"
LLM_MODEL="gemini-2.5-flash"
LLM_EMBEDDING_MODEL="gemini-embedding-001"
