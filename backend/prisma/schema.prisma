// AI Corporate Operations Agent — Database Schema
// Reference: SRS-OPS-AI-2026-V1.1, Section 9 (Database Schema Design)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's pooled connection (port 6543, pgbouncer transaction mode)
  // can't hold the session-level advisory lock `prisma migrate` needs — it
  // just hangs. `directUrl` (port 5432, unpooled) is what the migration
  // engine actually uses for migrate dev/deploy/status; `url` above stays
  // the pooled connection the app uses at runtime.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  SYSTEM_ADMIN
  DEPARTMENT_MANAGER
  TEAM_LEAD
  FINANCE_APPROVER
  EMPLOYEE
}

enum RequestChannel {
  slack
  assistant_ui
  email
}

enum RequestStatus {
  DRAFT
  PENDING_POLICY_CHECK
  PENDING_MANAGER_APPROVAL
  PENDING_FINANCE_APPROVAL
  // Routed to an EmployeeRole (e.g. HR) that must actually decide it — not
  // the dollar-amount pipeline above. See RequestsService.decideRoleStage.
  PENDING_ROLE_APPROVAL
  APPROVED
  // Finance approved a *stated, unverified* dollar amount (the "reserve now,
  // prove later" path — see RequestsService.decideFinanceStage/attachProof):
  // work can start, but the money hasn't actually been sent yet. Distinct
  // from APPROVED, which for the verified-receipt path already IS the spend
  // (nothing left to pay), so it stays terminal there.
  PENDING_PAYMENT
  REJECTED
  ESCALATED
  COMPLETED
  // Routed to an EmployeeRole purely as an FYI (e.g. "ask IT about the wifi
  // password") — logged and forwarded, but no approval was ever expected.
  // Distinct from COMPLETED so the UI/requester can tell "nothing needed
  // deciding" apart from "something was decided."
  NOTED
  CANCELLED
}

enum ExecutionStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AttachmentSource {
  slack
  assistant_ui
  email
}

// ─────────────────────────────────────────────
// Core tenancy & identity
// ─────────────────────────────────────────────

model Tenant {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  isActive    Boolean @default(true) @map("is_active")
  slackTeamId String? @map("slack_team_id")
  // Per-workspace bot credentials, captured during the "Add to Slack" OAuth install.
  slackBotToken  String? @map("slack_bot_token")
  slackBotUserId String? @map("slack_bot_user_id")
  // Channel where every message is treated as a query — no @mention required.
  slackQueryChannelId String?  @map("slack_query_channel_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users              User[]
  requests           Request[]
  financeDelegations FinanceDelegation[]
  policyDocuments    PolicyDocument[]
  auditLogs          AuditLog[]
  conversations      Conversation[]
  budgets            Budget[]
  employeeRoles      EmployeeRole[]
  roleBroadcasts     RoleBroadcast[]
  notifications      Notification[]

  @@map("tenants")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  email       String
  name        String
  passwordHash String? @map("password_hash")
  role        Role     @default(EMPLOYEE)
  department  String?
  slackUserId String?  @map("slack_user_id")
  isActive    Boolean  @default(true) @map("is_active")
  // Manually toggled by the employee themselves or a SYSTEM_ADMIN — distinct
  // from isActive (account blocked/enabled). Someone on leave keeps full
  // account access; they just shouldn't be routed requests while away. See
  // EmployeeRolesService.getUnavailableUserIds, which excludes them (along
  // with anyone on an approved formal leave request) from role-routing, so
  // requests fall through to the SYSTEM_ADMIN fallback instead of sitting
  // unseen.
  isOnLeave   Boolean  @default(false) @map("is_on_leave")
  // The specific person who is this employee's team lead — distinct from
  // the fixed Role.TEAM_LEAD enum value (permission tier) and from the
  // EmployeeRole "Team Lead" catalog tag (a shared, unowned label). This is
  // a real 1:1 reporting relationship, admin-assigned, so a leave request or
  // a "ask my team lead" query can notify the actual person rather than
  // whoever happens to hold a generic tag. See
  // EmployeeRolesService.notifyTeamLead.
  teamLeadId  String?  @map("team_lead_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teamLead User?  @relation("TeamLeadOf", fields: [teamLeadId], references: [id], onDelete: SetNull)

  requestsMade        Request[]           @relation("RequestRequester")
  delegationsGranted  FinanceDelegation[] @relation("DelegationGrantedBy")
  delegationsReceived FinanceDelegation[] @relation("DelegationDelegate")
  approvals           Approval[]
  conversations       Conversation[]
  auditLogs           AuditLog[]
  employeeRoles       UserEmployeeRole[]
  sentBroadcasts      RoleBroadcast[]
  teamMembers         User[]              @relation("TeamLeadOf")
  notifications       Notification[]

  @@unique([tenantId, email])
  @@map("users")
}

// ─────────────────────────────────────────────
// Employee Roles & Role-Targeted Broadcast Messaging
// ─────────────────────────────────────────────

// Admin-assignable department/function tags (e.g. "Human Resources (HR)",
// "Finance & Accounting") — independent from the Role enum used for
// permissions. A user can hold any number of these.
model EmployeeRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members          UserEmployeeRole[]
  broadcastTargets RoleBroadcastTarget[]
  routedRequests   Request[]

  @@unique([tenantId, name])
  @@map("employee_roles")
}

model UserEmployeeRole {
  userId         String   @map("user_id") @db.Uuid
  employeeRoleId String   @map("employee_role_id") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeRole EmployeeRole @relation(fields: [employeeRoleId], references: [id], onDelete: Cascade)

  @@id([userId, employeeRoleId])
  @@map("user_employee_roles")
}

// A message a system admin sent to everyone holding one or more target
// roles. If nobody reachable held any target role, it's redirected to the
// tenant's admins instead (forwardedToAdmin) rather than silently dropped.
model RoleBroadcast {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  senderId         String   @map("sender_id") @db.Uuid
  message          String   @db.Text
  recipientCount   Int      @map("recipient_count")
  forwardedToAdmin Boolean  @default(false) @map("forwarded_to_admin")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender  User                  @relation(fields: [senderId], references: [id])
  targets RoleBroadcastTarget[]

  @@index([tenantId])
  @@map("role_broadcasts")
}

model RoleBroadcastTarget {
  broadcastId    String @map("broadcast_id") @db.Uuid
  employeeRoleId String @map("employee_role_id") @db.Uuid

  broadcast    RoleBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  employeeRole EmployeeRole  @relation(fields: [employeeRoleId], references: [id], onDelete: Cascade)

  @@id([broadcastId, employeeRoleId])
  @@map("role_broadcast_targets")
}

// Platform-level admin — deliberately NOT a User/Tenant relation. Sits above
// tenant isolation entirely (see JwtAuthGuard's `kind: 'platform_admin'`
// claim check) rather than special-casing the per-tenant guard/query pattern
// every other identity in this schema follows.
model PlatformAdmin {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String?
  isGlobalAdmin Boolean  @default(false) @map("is_global_admin")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("platform_admins")
}

// ─────────────────────────────────────────────
// Finance Manager Delegation Framework (Section 3.1, FR-ADM)
// ─────────────────────────────────────────────

model FinanceDelegation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("delegation_id")
  tenantId          String    @map("tenant_id") @db.Uuid
  grantedByAdminId  String    @map("granted_by_admin_id") @db.Uuid
  delegateManagerId String    @map("delegate_manager_id") @db.Uuid
  departmentScope   String    @map("department_scope") // e.g. 'Engineering', 'Marketing', 'ALL'
  maxApprovalLimit  Decimal   @map("max_approval_limit") @db.Decimal(12, 2)
  isActive          Boolean   @default(true) @map("is_active")
  startTime         DateTime  @default(now()) @map("start_time") @db.Timestamptz
  endTime           DateTime? @map("end_time") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grantedByAdmin  User       @relation("DelegationGrantedBy", fields: [grantedByAdminId], references: [id])
  delegateManager User       @relation("DelegationDelegate", fields: [delegateManagerId], references: [id])
  approvals       Approval[]

  @@index([tenantId, delegateManagerId, isActive])
  @@map("finance_delegations")
}

// Department budget pool — allocated vs. actual spend (computed from Requests),
// distinct from FinanceDelegation.maxApprovalLimit which is an approval ceiling,
// not a budget.
model Budget {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  departmentScope String   @map("department_scope") // e.g. 'Engineering', 'ALL'
  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, departmentScope])
  @@map("budgets")
}

// ─────────────────────────────────────────────
// Requests (RequestIntent) — Section 5.1, 9
// ─────────────────────────────────────────────

model Request {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("request_id")
  tenantId       String         @map("tenant_id") @db.Uuid
  requesterId    String         @map("requester_id") @db.Uuid
  channel        RequestChannel
  rawPrompt      String         @map("raw_prompt") @db.Text
  parsedIntent   String         @map("parsed_intent")
  status         RequestStatus  @default(DRAFT)
  attachmentUrls Json           @default("[]") @map("attachment_urls")
  // LLM-extracted dollar amount stated in chat text, unverified (no receipt).
  // Distinct from an Attachment's OCR-extracted totalAmount, which is the
  // real/verified figure. Drives the "reserve now, prove later" finance
  // path — routes straight to PENDING_FINANCE_APPROVAL when set and no
  // attachment amount exists yet.
  statedAmount   Decimal?       @map("stated_amount") @db.Decimal(12, 2)
  // Which Budget.departmentScope this expense counts against — set by the
  // assistant at filing time (matched against the tenant's actual budget
  // categories), independent of the requester's own department. A "$100 for
  // new PCs" request should hit the "Office accessories" budget regardless
  // of which employee filed it; falls back to the requester's department
  // (old behavior) when the assistant couldn't confidently classify it.
  budgetDepartment String?      @map("budget_department")
  // Set when the assistant's file_request routed this to a specific
  // EmployeeRole (e.g. "Human Resources (HR)") — the source of truth for
  // who's allowed to act on a PENDING_ROLE_APPROVAL request (any holder of
  // this role, or SYSTEM_ADMIN), not just a notification target. Null for
  // the ordinary dollar-amount pipeline.
  routedRoleId   String?        @map("routed_role_id") @db.Uuid
  // Only meaningful alongside routedRoleId: true means a role-holder must
  // actually decide it (-> PENDING_ROLE_APPROVAL), false means it's purely
  // informational (-> NOTED, no decision expected). Set once at filing time
  // by the assistant; runPipeline reads it back since routing happens in a
  // later, separate call (after Slack file ingestion, for attachment-bearing
  // requests).
  requiresApproval Boolean?     @map("requires_approval")
  // Structured leave dates, extracted by the assistant when intentType is a
  // leave request (see FILING DECISIONS' slot-filling requirement — it must
  // have these before filing). Used to compute who's currently on leave for
  // EmployeeRolesService's approver-availability fallback — without a real
  // date range, "is this person on leave right now" can't be answered
  // programmatically at all.
  leaveStartDate DateTime?      @map("leave_start_date") @db.Date
  leaveEndDate   DateTime?      @map("leave_end_date") @db.Date
  // Free-text update from whoever a request was routed to (e.g. IT Support
  // saying "the router is fixed") — distinct from the APPROVED/REJECTED
  // decision, which only covers whether the money/ask was authorized, not
  // whether the actual work described is done. Surfaced back to the
  // requester via get_my_request_status and, when isResolved was set, a
  // direct notification. See RequestsService.recordProgressNote.
  progressNote   String?        @map("progress_note") @db.Text
  progressNoteAt DateTime?      @map("progress_note_at") @db.Timestamptz
  // Other employees who reported the same real-world issue after this
  // request was already filed (e.g. a second person also flagging the
  // broken upper-floor AC) — merged in here by the assistant's
  // join_existing_request tool instead of creating a duplicate ticket.
  // Json (not a join table) since this is display-only, same pragmatism as
  // attachmentUrls above: [{ userId, name, note, reportedAt }].
  additionalReporters Json      @default("[]") @map("additional_reporters")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester  User            @relation("RequestRequester", fields: [requesterId], references: [id])
  routedRole EmployeeRole?   @relation(fields: [routedRoleId], references: [id])
  attachments    Attachment[]
  executionSteps ExecutionStep[]
  policyCitations PolicyCitation[]
  approvals      Approval[]
  messages       Message[]

  @@index([tenantId, status])
  @@map("requests")
}

// ─────────────────────────────────────────────
// Slack Attachment Ingestion Engine — Section 5, FR-SLK
// ─────────────────────────────────────────────

model Attachment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId      String           @map("request_id") @db.Uuid
  source         AttachmentSource @default(slack)
  slackFileId    String?          @map("slack_file_id")
  urlPrivateDownload String?      @map("url_private_download")
  fileName       String?          @map("file_name")
  mimeType       String?          @map("mime_type")
  merchantName   String?          @map("merchant_name")
  totalAmount    Decimal?         @map("total_amount") @db.Decimal(12, 2)
  currency       String?          @default("USD")
  lineItems      Json?            @map("line_items")
  taxId          String?          @map("tax_id")
  documentDate   DateTime?        @map("document_date") @db.Date
  ocrRawText     String?          @map("ocr_raw_text") @db.Text
  // `fileData` is kept only as a migration safety net during the move to GCS
  // (see StorageService) — `storagePath` is the source of truth for new
  // uploads and gets dropped in a follow-up migration once the bucket
  // backfill is verified.
  fileData       Bytes?           @map("file_data")
  storagePath    String?          @map("storage_path")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("attachments")
}

// ─────────────────────────────────────────────
// AI Assistant Interface — Live Execution Timeline (FR-UI-002)
// ─────────────────────────────────────────────

model ExecutionStep {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId     String               @map("request_id") @db.Uuid
  stepName      String               @map("step_name") // e.g. "Checking Policy...", "Awaiting Finance Approval"
  status        ExecutionStepStatus  @default(PENDING)
  sequenceOrder Int                  @map("sequence_order")
  startedAt     DateTime?            @map("started_at") @db.Timestamptz
  completedAt   DateTime?            @map("completed_at") @db.Timestamptz
  metadata      Json?

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, sequenceOrder])
  @@map("execution_steps")
}

// ─────────────────────────────────────────────
// RAG Policy Citation — Context & Citation Viewer (FR-UI-003)
// ─────────────────────────────────────────────

model PolicyDocument {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  title      String
  sourceUrl  String?  @map("source_url")
  content    String   @db.Text
  version    String   @default("1.0")
  // GCS object path to the original uploaded file (PDF/txt/md), when one was
  // uploaded via /policies/upload — null for documents created from pasted
  // text directly, and for anything uploaded before this field existed.
  storagePath String? @map("storage_path")
  // Restricted to FINANCE_APPROVER/SYSTEM_ADMIN — excluded from search_policy
  // and policy-citation results for everyone else, so a document containing
  // real financial/budget detail isn't surfaced to a plain employee via chat
  // or the citation viewer on their own filed request.
  restricted Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  citations PolicyCitation[]
  chunks    PolicyChunk[]

  @@index([tenantId])
  @@map("policy_documents")
}

// Chunked + embedded policy content for RAG retrieval (SRS Section 5.1, step 5).
model PolicyChunk {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyDocumentId String   @map("policy_document_id") @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  content          String   @db.Text
  embedding        Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  policyDocument PolicyDocument @relation(fields: [policyDocumentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("policy_chunks")
}

model PolicyCitation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId        String   @map("request_id") @db.Uuid
  policyDocumentId String   @map("policy_document_id") @db.Uuid
  clauseSnippet    String   @map("clause_snippet") @db.Text
  relevanceScore   Decimal? @map("relevance_score") @db.Decimal(5, 4)
  citedAt          DateTime @default(now()) @map("cited_at") @db.Timestamptz

  request        Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  policyDocument PolicyDocument @relation(fields: [policyDocumentId], references: [id])

  @@index([requestId])
  @@map("policy_citations")
}

// ─────────────────────────────────────────────
// Approvals — Manager & Delegated Finance Approver actions
// ─────────────────────────────────────────────

model Approval {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId           String           @map("request_id") @db.Uuid
  approverId          String           @map("approver_id") @db.Uuid
  decision            ApprovalDecision @default(PENDING)
  decisionReason      String?          @map("decision_reason") @db.Text
  spendingAmount      Decimal?         @map("spending_amount") @db.Decimal(12, 2)
  isDelegatedApproval Boolean          @default(false) @map("is_delegated_approval")
  delegationId        String?          @map("delegation_id") @db.Uuid
  decidedAt           DateTime?        @map("decided_at") @db.Timestamptz
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz

  request    Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver   User               @relation(fields: [approverId], references: [id])
  delegation FinanceDelegation? @relation(fields: [delegationId], references: [id])

  @@index([requestId])
  @@map("approvals")
}

// ─────────────────────────────────────────────
// Conversational Command Canvas — multi-turn state (FR-UI-001)
// ─────────────────────────────────────────────

model Conversation {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  title     String?
  // Which surface this thread belongs to — Slack and the web Assistant UI
  // are separate conversations for the same person, never merged. Without
  // this, "resume the most recent conversation" (used on web load) could
  // resume a conversation that was actually a Slack DM, which reads as a
  // stray/duplicated message the user never typed in the browser.
  channel   RequestChannel  @default(assistant_ui) @map("channel")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([tenantId, userId, channel])
  @@map("conversations")
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String      @db.Text
  requestId      String?     @map("request_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  request      Request?     @relation(fields: [requestId], references: [id])

  @@index([conversationId])
  @@map("messages")
}

// ─────────────────────────────────────────────
// Audit Trail — FR-ADM-003
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// In-app notifications — the real-time counterpart to the Slack DMs sent
// from RequestsService.notify*. Written whenever one of those fires and
// pushed live over the socket (RealtimeService.emitToUser 'notification.new');
// persisted so the notification bell survives a reload / offline gap.
// ─────────────────────────────────────────────

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Free-form label, not an enum, so a new notification type never needs a
  // migration: REQUEST_APPROVED | REQUEST_REJECTED | REQUEST_PENDING_PAYMENT
  // | REQUEST_ROUTED | REQUEST_PROGRESS | REQUEST_PAYMENT_SENT.
  kind      String
  title     String
  body      String    @db.Text
  requestId String?   @map("request_id") @db.Uuid
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
